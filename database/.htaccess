# Database scripts, migrations and SQL backups are not web-accessible.
# Local migrations still run from the CLI:
#   C:\xampp\php\php.exe database\migrate.php
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
